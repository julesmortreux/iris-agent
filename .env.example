# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
MISTRAL_CHAT_MODEL=mistral-medium-2604

# API legacy (ici, la fausse API du dossier legacy_api)
LEGACY_API_BASE_URL=http://127.0.0.1:5001/api
# Jeton Bearer. S'il est vide, le cookie de session ci-dessous est utilisé.
LEGACY_API_TOKEN=demo-token
LEGACY_API_SESSION=
# Latence simulée de la fausse API, en millisecondes
LEGACY_API_LATENCY_MS=0

# Enrichissement des coordonnées pendant la recherche (l'API limite alors à 10 résultats)
IRIS_ENRICH_ON_SEARCH=false

# Serveur
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=*
